{
    "version": 8,
    "name": "map tyle",
    "sources": {
        "openmaptiles": {
            "type": "raster",
            "tiles": [
                "https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png"
                ],
            "tileSize": 256,
            "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
        }
    },
    "layers": [
        {
            "id": "simple-tiles",
            "type": "raster",
            "source": "openmaptiles",
            "minzoom": 0,
            "maxzoom": 19
        }
    ]

}

